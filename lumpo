    env.set('append', _builtin_append)
    env.set('keys', _builtin_keys)
    env.set('values', _builtin_values)
    env.set('floor_div', _builtin_floor_div)
    env.set('assert', _builtin_assert)
    env.set('push', _builtin_push)
    env.set('pop', _builtin_pop)
    env.set('has', _builtin_has)
    env.set('split', _builtin_split)
    env.set('join', _builtin_join)
    env.set('upper', _builtin_upper)
    env.set('lower', _builtin_lower)
    env.set('trim', _builtin_trim)
    env.set('substr', _builtin_substr)
    env.set('replace', _builtin_replace)
    env.set('contains', _builtin_contains)
    env.set('starts_with', _builtin_starts_with)
    env.set('ends_with', _builtin_ends_with)
    env.set('repeat', _builtin_repeat)
    env.set('pad_left', _builtin_pad_left)
    env.set('index_of', _builtin_index_of)
    env.set('has_key', _builtin_has_key)
    env.set('min', _builtin_min_)
    env.set('max', _builtin_max_)
    env.set('abs', _builtin_abs_)
    env.set('reverse', _builtin_reverse)
    env.set('sort', _builtin_sort)
    env.set('map', _builtin_map_)
    env.set('filter', _builtin_filter_)
    env.set('reduce', _builtin_reduce_)
    env.set('find', _builtin_find_)
    env.set('any', _builtin_any_)
    env.set('all', _builtin_all_)
    env.set('true', True)
    env.set('false', False)
    env.set('null', None)
    env.set('none', None)
    return env


# ── main ──
def _format_error_frame(path, line_no, msg):
    """render a rust-style error frame with source context"""
    try:
        src_lines = Path(path).read_text().splitlines()
    except OSError:
        src_lines = []
    out = [f"error: {msg}", f" --> {path} (line {line_no})"]
    if isinstance(line_no, int) and 0 < line_no <= len(src_lines):
        src = src_lines[line_no - 1]
        width = len(str(line_no)) + 2
        out.append(f"{' ' * width} |")
        out.append(f"{line_no} | {src}")
        out.append(f"{' ' * width} | {'^'}")
    return '\n'.join(out)


def run_file(path):
    global _current_file
    src = Path(path).read_text()
    _current_file = str(Path(path).resolve())
    try:
        tokens = tokenize(src)
        ast = Parser(tokens).parse()
    except SyntaxError as e:
        line_no = 1
        m = re.search(r'line (\d+)', str(e))
        if m:
            line_no = int(m.group(1))
        print(_format_error_frame(path, line_no, str(e)), file=sys.stderr)
        sys.exit(1)
    env = make_global_env()
    try:
        exec_block(ast.stmts, env)
    except (AssertionError, RuntimeError) as e:
        # LumpoError carries .line; others fall back to '?'
        line_no = getattr(e, 'line', None)
        if line_no is None:
            m = re.search(r'line (\d+)', str(e))
            line_no = int(m.group(1)) if m else '?'
        label = f"AssertionError: {e}" if isinstance(e, AssertionError) else str(e)
        print(_format_error_frame(path, line_no, label), file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(_format_error_frame(path, '?', str(e)), file=sys.stderr)
        sys.exit(1)


def repl():
    print(f"lumpo v{LUMPO_VERSION} REPL — type 'exit' to quit")
    env = make_global_env()
    while True:
        try:
            line = input("lumpo> ")
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if line.strip() == 'exit':
            break
        if not line.strip():
            continue
        try:
            tokens = tokenize(line)
            ast = Parser(tokens).parse()
            for s in ast.stmts:
                result = exec_stmt(s, env)
        except Exception as e:
            print(f"error: {e}")


def fmt_file(path):
    src = Path(path).read_text()
    # protect string literals from spacing rewrites
    placeholders = {}
    def _stash(m):
        key = f"\x00{len(placeholders)}\x00"
        placeholders[key] = m.group(0)
        return key
    protected = re.sub(r'"(?:[^"\\]|\\.)*"', _stash, src)
    protected = re.sub(r'\s*=\s*', ' = ', protected)
    protected = re.sub(r'\s*([+\-*/])\s*', r' \1 ', protected)
    protected = re.sub(r',\s*', ', ', protected)
    protected = re.sub(r'\b(let|fn|return|if|else|while|for|in|import|print|component)\s+',
                       r'\1 ', protected)
    protected = re.sub(r'\)\s*\{', ') {', protected)
    protected = re.sub(r'[ \t]+', ' ', protected)
    for key, val in placeholders.items():
        protected = protected.replace(key, val)
    lines = protected.split('\n')
    out = []
    indent = 0
    for raw in lines:
        line = raw.strip()
        if line == '':
            out.append('')
            continue
        if line.startswith('}'):
            indent = max(0, indent - 1)
        out.append('    ' * indent + line)
        if '{' in line:
            indent += 1
        elif '}' in line and not line.startswith('}'):
            indent = max(0, indent - 1)
    formatted = '\n'.join(out)
    Path(path).write_text(formatted)
    return formatted


def run_tests(path=None):
    """discover and run *_test.lp / test_*.lp files."""
    root = Path(path) if path else Path('.')
    if root.is_file():
        test_files = [root]
    else:
        pattern_paths = list(root.glob('**/*_test.lp')) + list(root.glob('**/test_*.lp'))
        test_files = sorted(set(pattern_paths))
    if not test_files:
        print("no test files found (*_test.lp / test_*.lp)")
        return 0
    passed, failed = 0, 0
    for tf in test_files:
        src = tf.read_text()
        # a test file passes if it runs without uncaught errors/assert failures
        try:
            tokens = tokenize(src)
            ast = Parser(tokens).parse()
            env = make_global_env()
            import io as _io
            buf = _io.StringIO()
            import contextlib
            with contextlib.redirect_stdout(buf):
                exec_block(ast.stmts, env)
            print(f"PASS {tf}")
            passed += 1
        except Exception as e:
            print(f"FAIL {tf}: {e}")
            failed += 1
    total = passed + failed
    print(f"\n{total} test file(s): {passed} passed, {failed} failed")
    return 1 if failed else 0


def dev_watch(path):
    """run a file, restart on any .lp change (polling watcher)."""
    import subprocess as _sp
    import time as _time

    def _snapshot():
        snaps = {}
        for f in Path('.').rglob('*.lp'):
            try:
                snaps[str(f)] = f.stat().st_mtime
            except OSError:
                pass
        return snaps

    proc = None
    last = _snapshot()
    print(f"lumpo dev: watching *.lp (ctrl-c to stop)")
    try:
        while True:
            if proc is None or proc.poll() is not None:
                if proc is not None:
                    print("lumpo dev: process exited, waiting for changes...")
                proc = _sp.Popen([sys.executable, str(Path(__file__).resolve()), 'run', path])
            _time.sleep(0.5)
            now = _snapshot()
            if now != last:
                changed = [k for k in set(now) | set(last) if now.get(k) != last.get(k)]
                print(f"lumpo dev: change detected ({', '.join(changed[:3])}), restarting...")
                if proc and proc.poll() is None:
                    proc.terminate()
                    try:
                        proc.wait(timeout=2)
                    except Exception:
                        proc.kill()
                proc = _sp.Popen([sys.executable, str(Path(__file__).resolve()), 'run', path])
                last = now
    except KeyboardInterrupt:
        print("\nlumpo dev: stopped")
        if proc and proc.poll() is None:
            proc.terminate()


def main():
    if len(sys.argv) < 2:
        print("usage: lumpo <command> [args]")
        print("commands:")
        print("  run <file.lp>    run a lumpo program")
        print("  repl             interactive REPL")
        print("  build <src> <out> build static site")
        print("  fmt <file.lp>    format source file in place")
        print("  test [path]      run *_test.lp / test_*.lp files")
        print("  dev <file.lp>    run + auto-restart on .lp changes")
        print("  --version        show version")
        sys.exit(1)

    cmd = sys.argv[1]

    if cmd == '--version':
        print(f"lumpo v{LUMPO_VERSION}")
        sys.exit(0)

    if cmd == 'run':
        if len(sys.argv) < 3:
            print("usage: lumpo run <file.lp>")
            sys.exit(1)
        run_file(sys.argv[2])
    elif cmd == 'repl':
        repl()
    elif cmd == 'fmt':
        if len(sys.argv) < 3:
            print("usage: lumpo fmt <file.lp>")
            sys.exit(1)
        fmt_file(sys.argv[2])
        print(f"formatted {sys.argv[2]}")
    elif cmd == 'test':
        target = sys.argv[2] if len(sys.argv) > 2 else None
        sys.exit(run_tests(target))
    elif cmd == 'dev':
        if len(sys.argv) < 3:
            print("usage: lumpo dev <file.lp>")
            sys.exit(1)
        dev_watch(sys.argv[2])
    elif cmd == 'build':
        # static site generator
        if len(sys.argv) < 4:
            print("usage: lumpo build <src_dir> <out_dir>")
            sys.exit(1)
        src_dir = Path(sys.argv[2])
        out_dir = Path(sys.argv[3])
        out_dir.mkdir(parents=True, exist_ok=True)
        count = 0
        for lp_file in src_dir.glob('*.lp'):
            tokens = tokenize(lp_file.read_text())
            ast = Parser(tokens).parse()
            env = make_global_env()
            # capture output
            import io as _io
            buf = _io.StringIO()
            old_print = __builtins__['print'] if isinstance(__builtins__, dict) else __builtins__.print
            def _cap_print(*a, **kw):
                buf.write(' '.join(str(x) for x in a))
                buf.write(kw.get('end', '\n'))
            if isinstance(__builtins__, dict):
                __builtins__['print'] = _cap_print
            else:
                __builtins__.print = _cap_print
            try:
                exec_block(ast.stmts, env)
            finally:
                if isinstance(__builtins__, dict):
                    __builtins__['print'] = old_print
                else:
                    __builtins__.print = old_print
            html_out = buf.getvalue()
            out_file = out_dir / (lp_file.stem + '.html')
            out_file.write_text(html_out)
            count += 1
        print(f"lumpo build: {count} file(s) → {out_dir}/")
    else:
        # fallback: treat as file
        if Path(cmd).exists() and cmd.endswith('.lp'):
            run_file(cmd)
        else:
            print(f"unknown command: {cmd}")
            sys.exit(1)


if __name__ == '__main__':
    main()
